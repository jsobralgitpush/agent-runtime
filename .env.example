APP_ENV=development
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_runtime
LOG_LEVEL=INFO
DEFAULT_STEP_TIMEOUT_SECONDS=30
MAX_STEP_RETRIES=5
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_RECOVERY_BATCH_SIZE=100
# Optional: registers the `openai` provider without persisting the credential.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: registers the `anthropic` provider without persisting the credential.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MAX_TOKENS=4096
